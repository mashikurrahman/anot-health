# Server Port
PORT=3000

# Anot Health SMTP Credentials
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your-smtp-user@example.com
SMTP_PASS=your-smtp-password
CONTACT_TO=admin@anot.health, mashikurrahman7@gmail.com

# Analytics & SEO Dashboard Admin Access
ADMIN_ANALYTICS_PASSWORD=AnotAdmin2026!
JWT_SECRET=change-this-to-a-random-secret-string

# Google Cloud Service Account Integration
# Place the downloaded Service Account JSON file into backend/service-account.json
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Google Analytics 4 (Numeric Property ID from GA4 > Admin > Property Details)
# Example: 428194821 (Note: this is numeric, NOT the G-XXXXXX Measurement ID)
GA4_PROPERTY_ID=

# Google Search Console Site URL
# Exact URL or Domain property as registered in Search Console
# Example: https://anot.health/ or sc-domain:anot.health
GSC_SITE_URL=https://anot.health/
